# Supabase — get from Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local scraper runtime
SCRAPER_HEADLESS=true

# Anthropic API — server-side only, used by POST /api/pitch
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_PITCH_MODEL=claude-sonnet-4-20250514

# Optional OpenAI fallback for POST /api/pitch
OPENAI_API_KEY=your-openai-api-key
PITCH_PRIMARY_PROVIDER=anthropic
PITCH_FALLBACK_PROVIDER=openai

# App origin — used to validate same-origin mutations in local/production deployments
APP_ORIGIN=http://localhost:3000

# Optional local scraper API base URL for manual/internal integrations
SCRAPER_LOCAL_API_URL=http://127.0.0.1:8000

# CRM ingestion secret — required by POST /api/crm/email/sync
CRM_INGESTION_SECRET=your-random-shared-secret

# Optional dedicated secret for POST /api/crm/whatsapp/sync
CRM_WHATSAPP_INGESTION_SECRET=your-random-whatsapp-shared-secret
