# Supabase — get from Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Maps Places API (New) — get from Google Cloud Console
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# PageSpeed Insights API — get from Google Cloud Console
PAGESPEED_API_KEY=your-pagespeed-api-key
